{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "activity-journal-strava",
  "main": "index.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "vars": {
    "GITHUB_REPOSITORY": "yslemmo/activity-journal",
    "STRAVA_ATHLETE_ID": "136709829"
  },
  "durable_objects": {
    "bindings": [{"name": "SYNC", "class_name": "SyncCoordinator"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["SyncCoordinator"]}]
}
